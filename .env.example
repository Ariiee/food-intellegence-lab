# Food Intelligence Lab - Configuration

# ==========================================
# 1. AUTHENTICATION & DATABASE (REQUIRED)
# ==========================================
# Connection string for your PostgreSQL database (used by Better Auth and Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/foodlab?schema=public"

# A secure random string used to sign sessions (you can use any long random string here)
BETTER_AUTH_SECRET="your_secure_random_secret_string"

# Google OAuth Credentials (Required for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials (Required for GitHub Sign-In)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# 2. AI & API KEYS (REQUIRED FOR SEARCH)
# ==========================================
# Google Gemini AI API Key (Free tier from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# ==========================================
# 3. OPTIONAL THIRD PARTY APIS
# ==========================================
# USDA FoodData Central API Key (Free from https://api.data.gov/signup/ or DEMO_KEY)
VITE_USDA_API_KEY=DEMO_KEY

# Spoonacular API Key (Optional free tier 150 req/day from https://spoonacular.com/food-api)
VITE_SPOONACULAR_API_KEY=
